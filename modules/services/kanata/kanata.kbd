(defcfg
  process-unmapped-keys yes
)

(defsrc
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  a s d f j k l ;
)

(defvar
  tap-time 150
  hold-time 250
  prior-idle 200
)

(deftemplate hrm (char mod)
  (switch
    ((key-timing 3 less-than $prior-idle)) $char break
    () (tap-hold-release-timeout $tap-time $hold-time $char $mod $char) break
  )
)

(defalias
  a (t! hrm a lsft)
  s (t! hrm s lmet)
  d (t! hrm d lalt)
  f (t! hrm f lctl)
  j (t! hrm j rctl)
  k (t! hrm k ralt)
  l (t! hrm l rmet)
  ; (t! hrm ; rsft)
  fn (layer-while-held fn)
)

(deflayer default
  @fn  brdn brup _ _    _    _    prev pp   next mute vold volu
  @a @s @d @f @j @k @l @;
)

(deflayer fn
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _ _ _ _ _ _ _ _
)
